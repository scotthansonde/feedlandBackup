  <body>
    <outline text="October 2026" created="Fri, 02 Oct 2026 14:17:34 GMT" name="october2026" type="calendarMonth">
      <outline text="October 5" created="Mon, 05 Oct 2026 15:26:29 GMT" type="calendarDay" name="05">
        <outline text="FWIW, I don't see the scary dialog with I access http://scripting.com on the latest Chrome" created="Mon, 05 Oct 2026 16:45:05 GMT" type="outline"/>
        <outline text="Did maintenance on the instant outline" created="Mon, 05 Oct 2026 15:26:30 GMT" type="outline">
          <outline text="Made includes for past months in 2026" created="Mon, 05 Oct 2026 15:27:22 GMT"/>
          <outline text="File is not 16KB instead of 120KB" created="Mon, 05 Oct 2026 15:28:29 GMT"/>
          <outline text="Then the outline won't be so brittle" created="Mon, 05 Oct 2026 15:27:40 GMT"/>
        </outline>
      </outline>
      <outline text="October 4" created="Sun, 04 Oct 2026 07:54:33 GMT" type="calendarDay" name="04">
        <outline text="Pulled down the code from the helloFrontier repo " created="Sun, 04 Oct 2026 07:54:34 GMT" type="outline">
          <outline text="I was able to build the app for both x64 and arm64 " created="Sun, 04 Oct 2026 07:55:04 GMT"/>
          <outline text="Claude also showed me how to export workspace.notepad to a local OPML file" created="Sun, 04 Oct 2026 08:05:38 GMT"/>
        </outline>
      </outline>
      <outline text="October 3" created="Sat, 03 Oct 2026 08:48:23 GMT" type="calendarDay" name="03">
        <outline text="My notes from my first run of Electric Frontier temporarily got lost " created="Sat, 03 Oct 2026 14:40:48 GMT" type="outline">
          <outline text="There were about 10 lines that disappeared, which I could recover from my GitHub backup" created="Sat, 03 Oct 2026 14:40:44 GMT">
            <outline text="Looks like Dave saw my notes before they disappeared 😃" created="Sat, 03 Oct 2026 14:41:52 GMT"/>
            <outline text="And I make regular backups on GitHub, I can get all the lines back... and I got them back " created="Sat, 03 Oct 2026 14:50:08 GMT"/>
          </outline>
          <outline text="BTW I did run Electric Frontier by double-clicking on the app, I just had claude guide me through it " created="Sat, 03 Oct 2026 14:43:24 GMT"/>
        </outline>
        <outline text="Trying out Electric Frontier" created="Sat, 03 Oct 2026 08:48:24 GMT" type="outline">
          <outline text="Listened to the voicemail" created="Sat, 03 Oct 2026 08:48:53 GMT"/>
          <outline text="Opened a claude code session, pointed it to the HelloFrontier repo  " created="Sat, 03 Oct 2026 08:49:13 GMT"/>
          <outline text="It wrote a test plan for the install and first start" created="Sat, 03 Oct 2026 09:02:32 GMT"/>
          <outline text="I notice the app is built for Intel only, rather than universal" created="Sat, 03 Oct 2026 09:16:45 GMT"/>
          <outline text="First start works, it opens workspace.notepad, started taking notes with cmd-4" created="Sat, 03 Oct 2026 09:21:45 GMT"/>
          <outline text="Quit and restart, my edits to workspace.notepad are still there" created="Sat, 03 Oct 2026 09:23:26 GMT"/>
          <outline text="Asked claude how to run the helloFrontier example" created="Sat, 03 Oct 2026 09:31:30 GMT">
            <outline text="It showed me how to get to workspace.userlandSamples and copy in the script" created="Sat, 03 Oct 2026 09:44:49 GMT">
              <outline text="Claude didn't know that helloFrontier is already shipped in the db" created="Sat, 03 Oct 2026 09:57:17 GMT"/>
              <outline text="So I ended up overwriting the original script" created="Sat, 03 Oct 2026 09:58:00 GMT"/>
              <outline text="But claude showed me how to restore it" created="Sat, 03 Oct 2026 10:01:25 GMT"/>
            </outline>
            <outline text="It compiles and it works" created="Sat, 03 Oct 2026 09:46:13 GMT"/>
            <outline text="Made a bookmark for userlandSamples" created="Sat, 03 Oct 2026 09:46:19 GMT"/>
          </outline>
          <outline text="I notice some of the shortcuts don't work on the German keyboard" created="Sat, 03 Oct 2026 09:49:06 GMT">
            <outline text="I've ordered a US keyboard, then that won't get in the way" created="Sat, 03 Oct 2026 09:50:50 GMT"/>
          </outline>
          <outline text="That's all for now, I'd call that a pretty good first day" created="Sat, 03 Oct 2026 09:53:15 GMT"/>
        </outline>
      </outline>
      <outline text="October 2" created="Fri, 02 Oct 2026 14:17:35 GMT" type="calendarDay" name="02">
        <outline text="Dave, let me know when a release of Atlantis is ready for me to try ou" created="Fri, 02 Oct 2026 14:17:36 GMT" type="outline"/>
      </outline>
    </outline>
    <outline text="September 2026" created="Fri, 04 Sep 2026 15:21:55 GMT" name="september2026" type="calendarMonth">
      <outline text="September 30" created="Wed, 30 Sep 2026 14:21:34 GMT" type="calendarDay" name="30">
        <outline text="The horizontal scrolling is just css 😃. It was mostly claude's idea.  " created="Wed, 30 Sep 2026 14:21:35 GMT" type="outline">
          <outline text="@media screen and (max-width: 768px) {" created="Mon, 28 Sep 2026 15:17:34 GMT">
            <outline text=".divRiverTabs .nav-tabs {" created="Mon, 28 Sep 2026 15:40:43 GMT">
              <outline text="display: flex;" created="Wed, 30 Sep 2026 14:24:30 GMT"/>
              <outline text="flex-wrap: nowrap;" created="Wed, 30 Sep 2026 14:24:28 GMT"/>
              <outline text="overflow-x: auto;" created="Mon, 28 Sep 2026 15:40:44 GMT"/>
              <outline text="-webkit-overflow-scrolling: touch;" created="Wed, 30 Sep 2026 14:24:40 GMT"/>
              <outline text="white-space: nowrap;"/>
            </outline>
            <outline text="}" created="Wed, 30 Sep 2026 14:23:46 GMT"/>
            <outline text=".divRiverTabs .nav-tabs &gt; li {" created="Mon, 28 Sep 2026 15:40:40 GMT">
              <outline text="float: none;"/>
              <outline text="flex: 0 0 auto;"/>
            </outline>
            <outline text="}" created="Wed, 30 Sep 2026 14:23:00 GMT"/>
          </outline>
          <outline text="}" created="Wed, 30 Sep 2026 14:23:53 GMT"/>
        </outline>
      </outline>
      <outline text="September 28" created="Mon, 28 Sep 2026 14:59:31 GMT" type="calendarDay" name="28">
        <outline text="The new tabs in words" created="Mon, 28 Sep 2026 18:20:59 GMT" type="outline">
          <outline text="By default FeedLand shows only 4 tabs on mobile." created="Mon, 28 Sep 2026 18:21:06 GMT">
            <outline text="misc.js sets isMobileDevice to true if window.innerWidth &lt;= 576" created="Mon, 28 Sep 2026 18:23:08 GMT"/>
            <outline text="riverviewer.js setzt maxtabs to 4 if isMobileDevice is true" created="Mon, 28 Sep 2026 18:24:17 GMT"/>
          </outline>
          <outline text="So I redefined isMobileDevice to false" created="Mon, 28 Sep 2026 18:25:09 GMT"/>
          <outline text="Then added some CSS to put the tabs on one line and make them scroll horizontally " created="Mon, 28 Sep 2026 18:25:49 GMT"/>
          <outline text="This is just something I wanted for myself" created="Mon, 28 Sep 2026 18:27:09 GMT">
            <outline text="But after doing the River Embed plugin, I thought Claude and I could figure it out" created="Mon, 28 Sep 2026 18:27:09 GMT"/>
          </outline>
        </outline>
        <outline text="FeedLand with infinite tabs on mobile" created="Mon, 28 Sep 2026 15:08:10 GMT" type="outline">
          <outline text="It's always bugged me that I can only see four tabs on mobile" created="Mon, 28 Sep 2026 15:08:35 GMT"/>
          <outline text="I always knew I could override the JS and CSS to change it, but I never got around to it" created="Mon, 28 Sep 2026 15:09:07 GMT"/>
          <outline text="Finally I did it" created="Mon, 28 Sep 2026 15:09:38 GMT">
            <outline text="Downloaded http://scripting.com/code/feedland/home/index.html to a S3-compatible bucket" created="Mon, 28 Sep 2026 15:09:55 GMT">
              <outline text="https://static.shanson.de/feedland/index.html" created="Mon, 28 Sep 2026 15:12:59 GMT"/>
            </outline>
            <outline text="Set urlServerHomePageSource to the new URL" created="Mon, 28 Sep 2026 15:12:03 GMT"/>
            <outline text="Added a script tag to unset window.isMobileDevice" created="Mon, 28 Sep 2026 15:13:32 GMT">
              <outline text="&lt;script&gt;function isMobileDevice () { return false; }&lt;/script&gt;" created="Mon, 28 Sep 2026 15:14:56 GMT"/>
            </outline>
            <outline text="Added some CSS for mobile so the tags appear in a single row I can scroll with my finger" created="Mon, 28 Sep 2026 15:16:10 GMT">
              <outline text="@media screen and (max-width: 768px) {" created="Mon, 28 Sep 2026 15:17:34 GMT">
                <outline text=".divRiverTabs .nav-tabs {" created="Mon, 28 Sep 2026 15:40:43 GMT">
                  <outline text="display: flex;" created="Wed, 30 Sep 2026 14:24:30 GMT"/>
                  <outline text="flex-wrap: nowrap;" created="Wed, 30 Sep 2026 14:24:28 GMT"/>
                  <outline text="overflow-x: auto;" created="Mon, 28 Sep 2026 15:40:44 GMT"/>
                  <outline text="-webkit-overflow-scrolling: touch;" created="Wed, 30 Sep 2026 14:24:40 GMT"/>
                  <outline text="white-space: nowrap;"/>
                </outline>
              </outline>
              <outline text="}" created="Wed, 30 Sep 2026 14:23:46 GMT"/>
              <outline text=".divRiverTabs .nav-tabs &gt; li {" created="Mon, 28 Sep 2026 15:40:40 GMT">
                <outline text="float: none;"/>
                <outline text="flex: 0 0 auto;"/>
              </outline>
              <outline text="}" created="Wed, 30 Sep 2026 14:23:00 GMT"/>
              <outline text="}" created="Wed, 30 Sep 2026 14:22:40 GMT"/>
            </outline>
          </outline>
          <outline text="View https://feedland.shanson.de/?river=true&amp;screenname=shanson on mobile to see how it looks" created="Mon, 28 Sep 2026 15:17:44 GMT" type="link" url="https://feedland.shanson.de/?river=true&amp;screenname=shanson"/>
          <outline text="Screenshot" created="Mon, 28 Sep 2026 15:36:55 GMT">
            <outline text="&lt;img src=&quot;https://images.scotthanson.de/cdn-cgi/image/width=250/outlines/SMH_FeedLand-1.png&quot;&gt;" created="Mon, 28 Sep 2026 15:45:52 GMT"/>
          </outline>
        </outline>
        <outline text="Scott the Project" created="Mon, 28 Sep 2026 14:59:32 GMT" type="outline">
          <outline text="Yes, I'm willing to try this out. Let me know when there I something I can install." created="Mon, 28 Sep 2026 14:59:51 GMT"/>
        </outline>
      </outline>
      <outline text="September 18" created="Fri, 18 Sep 2026 14:54:50 GMT" type="calendarDay" name="18">
        <outline text="&quot;scott: forget about the wordpress account&quot;" created="Fri, 18 Sep 2026 14:54:51 GMT" type="outline">
          <outline text="OK, I hadn't started on it yet." created="Fri, 18 Sep 2026 14:54:56 GMT"/>
          <outline text="Somehow I didn't see your Sep 17 outline until today. Whatever." created="Fri, 18 Sep 2026 14:55:12 GMT"/>
        </outline>
      </outline>
      <outline text="September 14" created="Mon, 14 Sep 2026 07:03:42 GMT" type="calendarDay" name="14">
        <outline text="The River Embed plugin has been approved 😃" created="Mon, 14 Sep 2026 07:03:43 GMT" type="outline">
          <outline text="The URL will be https://wordpress.org/plugins/river-embed-for-feedland/" created="Mon, 14 Sep 2026 07:04:04 GMT" type="link" url="https://wordpress.org/plugins/river-embed-for-feedland/"/>
          <outline text="It takes a few hours for the directory to fully update" created="Mon, 14 Sep 2026 07:04:28 GMT"/>
        </outline>
      </outline>
      <outline text="September 11" created="Fri, 11 Sep 2026 14:47:52 GMT" type="calendarDay" name="11">
        <outline text="Next review from the WordPress Plugin Directory" created="Fri, 11 Sep 2026 14:47:53 GMT" type="outline">
          <outline text="They still complain that we don't wp_enqueue the JS and CSS " created="Fri, 11 Sep 2026 14:48:22 GMT"/>
          <outline text="But the enqueue functions cannot enqueue into a srcdoc iframe that we are using" created="Fri, 11 Sep 2026 14:49:00 GMT"/>
          <outline text="Have asked for clarification, a workaround would be complicated" created="Fri, 11 Sep 2026 14:49:42 GMT"/>
        </outline>
      </outline>
      <outline text="September 8" created="Tue, 08 Sep 2026 15:57:15 GMT" type="calendarDay" name="08">
        <outline text="Dave, thanks for the pointer to the plugin" created="Tue, 08 Sep 2026 15:57:16 GMT" type="outline">
          <outline text="It should take just a week or so to see if it gets accepted to the plugin directory" created="Tue, 08 Sep 2026 15:57:24 GMT"/>
          <outline text="Then it will be much easier to install and use 😃" created="Tue, 08 Sep 2026 15:58:07 GMT"/>
        </outline>
      </outline>
      <outline text="September 7" created="Mon, 07 Sep 2026 14:27:01 GMT" type="calendarDay" name="07">
        <outline text="Page for FeedLand Rivers plugin" created="Mon, 07 Sep 2026 14:27:02 GMT" type="outline">
          <outline text="My blog post about the plugin &lt;a href=&quot;https://wordland.shanson.de/2026/08/27/feedland-rivers-for-wordpress/&quot;&gt;https://wordland.shanson.de/2026/08/27/feedland-rivers-for-wordpress/&lt;/a&gt;" created="Mon, 07 Sep 2026 14:27:18 GMT" type="link" url="https://wordland.shanson.de/2026/08/27/feedland-rivers-for-wordpress/"/>
          <outline text="Or the GitHub repo &lt;a href=&quot;https://github.com/scotthansonde/feedland-rivers&quot;&gt;https://github.com/scotthansonde/feedland-rivers&lt;/a&gt;" created="Mon, 07 Sep 2026 14:28:08 GMT" type="link" url="https://github.com/scotthansonde/feedland-rivers"/>
          <outline text="Right now people have to download the latest release from GitHub and upload it to their WordPress site" created="Mon, 07 Sep 2026 14:29:04 GMT"/>
          <outline text="Once it's approved for the Plugin Directory, they'll be able to install it from within WordPress" created="Mon, 07 Sep 2026 14:29:34 GMT"/>
        </outline>
      </outline>
      <outline text="September 6" created="Sun, 06 Sep 2026 08:05:12 GMT" type="calendarDay" name="06">
        <outline text="2nd WordPress review of the River Embed plugin" created="Sun, 06 Sep 2026 08:05:13 GMT" type="outline">
          <outline text="Some documentation fixes" created="Sun, 06 Sep 2026 08:05:40 GMT"/>
          <outline text="They complained we weren't using enqueue functions to inject css and js" created="Sun, 06 Sep 2026 08:05:53 GMT">
            <outline text="Explained that enqueue functions don't work in an iframe, so we can't use them" created="Sun, 06 Sep 2026 08:06:32 GMT"/>
          </outline>
        </outline>
      </outline>
      <outline text="September 4" created="Fri, 04 Sep 2026 15:21:56 GMT" type="calendarDay" name="04">
        <outline text="Submitted the Rivers plugin to the WordPress Plugin Directory " created="Fri, 04 Sep 2026 15:21:57 GMT" type="outline">
          <outline text="They didn't &quot;FeedLand&quot; as the first word of the name, as it implies it's an official FeedLand plugin" created="Fri, 04 Sep 2026 15:48:01 GMT"/>
          <outline text="I set the name to &quot;River Embed for FeedLand&quot; to get around this." created="Fri, 04 Sep 2026 15:48:41 GMT"/>
        </outline>
      </outline>
    </outline>
    <outline text="August 2026" created="Mon, 05 Oct 2026 15:25:33 GMT" type="include" url="https://f001.backblazeb2.com/file/ps-assets/outlines/notes2026-08.opml"/>
